# Copy this file to db.properties.local on each developer machine.
# Do not commit db.properties.local because it contains local credentials.
# (Same workflow as Aden / Team 37: .info on GitHub, password only in chat + .local.)
#
# Resolution order used by the app:
# 1) db.properties.local (classpath resource — ClassLoader getResourceAsStream)
# 2) Environment variables (see below)
# 3) Built-in localhost defaults
#
# --- Recommended: host / port / name (matches MySQL Workbench) ---
# If db.host, db.port, and db.name are all set, the app builds the JDBC URL for you.
# db.url is NOT required in that case.
#
# db.host=<HOST>
# db.port=<PORT>
# db.name=<DB_NAME>
# db.username=<USERNAME>
# db.password=<PASSWORD>
# db.init.mode=SHARED
#
# Optional: extra JDBC query parameters (default is Railway-friendly MySQL)
# db.url.params=allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC
#
# Environment variables (optional alternative to the file):
# IPOS_DB_HOST, IPOS_DB_PORT, IPOS_DB_NAME, IPOS_DB_USERNAME, IPOS_DB_PASSWORD, IPOS_DB_URL_PARAMS
# IPOS_DB_INIT_MODE=LOCAL|SHARED
#
# --- Fallback: full JDBC URL (only if you omit host/port/name) ---
# db.url=jdbc:mysql://<HOST>:<PORT>/<DB_NAME>?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC
# Or: IPOS_DB_URL=...
#
# Init mode:
# - db.init.mode=LOCAL  -> app auto-runs schema.sql + seed.sql (your own local DB)
# - db.init.mode=SHARED -> app only connects; no schema/seed writes (shared / team DB)
# If omitted: LOCAL for localhost/sqlite URLs, SHARED for any other host.
#
# For SSL-required hosts, set e.g.:
# db.url.params=useSSL=true&requireSSL=true&serverTimezone=UTC
