<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="300.0" prefWidth="300.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-border-radius: 20;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.berrybyte.ORD.controllers.RecordPaymentPopupController">
    <children>
        <AnchorPane prefHeight="50.0" prefWidth="300.0" style="-fx-background-color: #DCD1EB; -fx-background-radius: 16 16 0 0;">
            <children>
                <Label layoutX="16.0" layoutY="14.0" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16px; -fx-text-fill: #1F1F1F;" text="Record Payment" />
                <Button fx:id="closeButton" layoutX="260.0" layoutY="8.0" mnemonicParsing="false" onAction="#handleClose" prefHeight="30.0" prefWidth="30.0" style="-fx-background-color: transparent; -fx-font-size: 16px; -fx-text-fill: #1F1F1F; -fx-cursor: hand;" text="X" />
            </children>
        </AnchorPane>

        <Label layoutX="16.0" layoutY="66.0" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12px;" text="Order ID" />
        <TextField fx:id="orderIdField" editable="false" layoutX="16.0" layoutY="84.0" prefHeight="32.0" prefWidth="268.0" promptText="Enter order ID" style="-fx-background-color: #F9F9F9; -fx-background-radius: 8; -fx-border-color: #D8D8D8; -fx-border-radius: 8; -fx-font-size: 12px;" />

        <Label layoutX="16.0" layoutY="124.0" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12px;" text="Amount Paid" />
        <TextField fx:id="amountPaidField" layoutX="16.0" layoutY="142.0" prefHeight="32.0" prefWidth="268.0" promptText="GBP 0.00" style="-fx-background-color: #F9F9F9; -fx-background-radius: 8; -fx-border-color: #D8D8D8; -fx-border-radius: 8; -fx-font-size: 12px;" />

        <Label layoutX="16.0" layoutY="182.0" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12px;" text="Method" />
        <ComboBox fx:id="paymentMethodComboBox" layoutX="16.0" layoutY="200.0" prefHeight="32.0" prefWidth="268.0" promptText="Select method" style="-fx-background-color: #F9F9F9; -fx-background-radius: 8; -fx-border-color: #9F84C2; -fx-border-radius: 8; -fx-font-size: 12px;" />

        <Button fx:id="cancelButton" layoutX="16.0" layoutY="248.0" mnemonicParsing="false" onAction="#handleClose" prefHeight="34.0" prefWidth="88.0" style="-fx-background-color: #D7D4DB; -fx-background-radius: 10; -fx-text-fill: white; -fx-font-family: 'Segoe UI Semibold'; -fx-font-size: 12px; -fx-cursor: hand;" text="Cancel" />
        <Button fx:id="confirmPaymentButton" layoutX="114.0" layoutY="248.0" mnemonicParsing="false" onAction="#handleConfirmPayment" prefHeight="34.0" prefWidth="170.0" style="-fx-background-color: #8067A6; -fx-background-radius: 10; -fx-text-fill: white; -fx-font-family: 'Segoe UI Semibold'; -fx-font-size: 12px; -fx-cursor: hand;" text="Confirm Payment" />
    </children>
</AnchorPane>
