<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="420.0" prefWidth="600.0" style="-fx-background-color: white; -fx-background-radius: 15;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.berrybyte.catalogue.LowStockNotificationController">
   <children>
      <AnchorPane prefHeight="60.0" prefWidth="600.0" style="-fx-background-color: #e1c3c3; -fx-background-radius: 15 15 0 0;">
         <children>
            <Label layoutX="20.0" layoutY="15.0" text="Low Stock Alert" textFill="#49454f">
               <font>
                  <Font name="Verdana Bold" size="20.0" />
               </font>
            </Label>
         </children>
      </AnchorPane>
      <Label layoutX="20.0" layoutY="75.0" prefWidth="560.0" text="The following items are at or below their stock limit:" textFill="#49454f">
         <font>
            <Font size="13.0" />
         </font>
      </Label>
      <TableView fx:id="lowStockTable" layoutX="20.0" layoutY="100.0" prefHeight="265.0" prefWidth="560.0">
         <columns>
            <TableColumn fx:id="itemIdColumn" prefWidth="93.5" text="Item ID" />
            <TableColumn fx:id="descriptionColumn" prefWidth="177.5" text="Description" />
            <TableColumn fx:id="availabilityColumn" prefWidth="143.0" text="Availability (Packs)" />
            <TableColumn fx:id="stockLimitColumn" prefWidth="146.0" text="Stock Limit (Packs)" />
         </columns>
      </TableView>
      <Button layoutX="260.0" layoutY="378.0" mnemonicParsing="false" onAction="#handleOk" prefHeight="30.0" prefWidth="80.0" style="-fx-background-color: #6C5A86; -fx-background-radius: 18;" text="OK" textFill="WHITE">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
