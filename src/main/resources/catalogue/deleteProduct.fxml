<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0"
            prefWidth="900.0"
            style="-fx-background-color: #D2C3E3;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.berrybyte.catalogue.DeleteProductController">
   <children>
      <ImageView fitHeight="62.0"
                 fitWidth="88.0"
                 pickOnBounds="true"
                 preserveRatio="true"
                 AnchorPane.leftAnchor="38.0"
                 AnchorPane.topAnchor="33.0">
         <image>
            <Image url="@../login/images/Logo_No_Background.PNG" />
         </image>
      </ImageView>

      <ImageView fx:id="backButton"
                 fitHeight="52.0"
                 fitWidth="40.0"
                 onMouseClicked="#handleBackButton"
                 pickOnBounds="true"
                 preserveRatio="true"
                 AnchorPane.rightAnchor="34.0"
                 AnchorPane.topAnchor="36.0">
         <image>
            <Image url="@../login/images/BackButton.png" />
         </image>
      </ImageView>

      <HBox alignment="CENTER"
            spacing="18.0"
            AnchorPane.leftAnchor="185.0"
            AnchorPane.rightAnchor="185.0"
            AnchorPane.topAnchor="58.0">
         <children>
            <TextField fx:id="searchField"
                       alignment="CENTER"
                       onAction="#handleSearch"
                       prefHeight="35.0"
                       prefWidth="330.0"
                       promptText="Search item"
                       style="-fx-background-radius: 18;" />
            <Button mnemonicParsing="false"
                    onAction="#handleSearch"
                    prefHeight="30.0"
                    prefWidth="120.0"
                    style="-fx-background-color: #6C5A86; -fx-background-radius: 18;"
                    text="Search"
                    textFill="WHITE">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>
         </children>
      </HBox>

      <Label fx:id="messageLabel"
             alignment="CENTER"
             contentDisplay="CENTER"
             prefHeight="20.0"
             textFill="#8f0808"
             AnchorPane.leftAnchor="220.0"
             AnchorPane.rightAnchor="220.0"
             AnchorPane.topAnchor="105.0" />

      <StackPane AnchorPane.bottomAnchor="85.0"
                 AnchorPane.leftAnchor="40.0"
                 AnchorPane.rightAnchor="40.0"
                 AnchorPane.topAnchor="130.0">
         <children>
            <AnchorPane maxHeight="460.0"
                        maxWidth="1080.0"
                        minHeight="340.0"
                        minWidth="760.0"
                        prefHeight="390.0"
                        prefWidth="820.0"
                        style="-fx-background-color: #E8DEF8; -fx-background-radius: 20;">
               <children>
                  <TableView fx:id="productsTable"
                             AnchorPane.bottomAnchor="18.0"
                             AnchorPane.leftAnchor="18.0"
                             AnchorPane.rightAnchor="18.0"
                             AnchorPane.topAnchor="18.0">
                     <columns>
                        <TableColumn fx:id="itemIdColumn" prefWidth="90.0" text="Item ID" />
                        <TableColumn fx:id="descriptionColumn" prefWidth="170.0" text="Description" />
                        <TableColumn fx:id="packageTypeColumn" prefWidth="120.0" text="Package Type" />
                        <TableColumn fx:id="unitColumn" prefWidth="80.0" text="Unit" />
                        <TableColumn fx:id="unitsInPackColumn" prefWidth="110.0" text="Units in a pack" />
                        <TableColumn fx:id="packageCostColumn" prefWidth="110.0" text="Package Cost, &#163;" />
                        <TableColumn fx:id="availabilityPacksColumn" prefWidth="105.0" text="Availability, Packs" />
                        <TableColumn fx:id="stockLimitPacksColumn" prefWidth="110.0" text="Stock Limit, Packs" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </children>
            </AnchorPane>
         </children>
      </StackPane>

      <HBox alignment="CENTER"
            AnchorPane.bottomAnchor="24.0"
            AnchorPane.leftAnchor="0.0"
            AnchorPane.rightAnchor="0.0">
         <children>
            <Button mnemonicParsing="false"
                    onAction="#handleDeleteProduct"
                    prefHeight="42.0"
                    prefWidth="190.0"
                    style="-fx-background-color: #6C5A86; -fx-background-radius: 18;"
                    text="Delete Product"
                    textFill="WHITE">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>
         </children>
      </HBox>
   </children>
</AnchorPane>
