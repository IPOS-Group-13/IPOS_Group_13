<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #D2C3E3;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.berrybyte.dashboard.AdminDashboardController">
   <children>

      <Label text="Dashboard" AnchorPane.leftAnchor="200.0" AnchorPane.topAnchor="36.0">
         <font>
            <Font name="Segoe UI Bold" size="36.0" />
         </font>
      </Label>

      <ImageView fx:id="profileImage" fitHeight="52.0" fitWidth="82.0" onMouseClicked="#handleProfileClick" pickOnBounds="true" preserveRatio="true" AnchorPane.rightAnchor="18.0" AnchorPane.topAnchor="36.0">
         <image>
            <Image url="@../login/images/account_circle-Photoroom.png" />
         </image>
      </ImageView>

      <AnchorPane fx:id="profileMenuPane" prefHeight="43.0" prefWidth="200.0" style="-fx-background-color: White; -fx-background-radius: 10;" AnchorPane.rightAnchor="74.0" AnchorPane.topAnchor="79.0">
         <children>
            <Button layoutX="14.0" layoutY="9.0" mnemonicParsing="false" onAction="#handleLogoutMenuClick" style="-fx-background-color: white;" text="Logout">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>
            <ImageView fitHeight="33.0" fitWidth="38.0" layoutX="156.0" layoutY="5.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../login/images/Log in-Photoroom.png" />
               </image>
            </ImageView>
         </children>
      </AnchorPane>

      <AnchorPane prefWidth="141.0" style="-fx-background-color: #A89CB6; -fx-background-radius: 20;" AnchorPane.bottomAnchor="37.0" AnchorPane.leftAnchor="23.0" AnchorPane.topAnchor="37.0">
         <children>
            <ImageView fitHeight="52.0" fitWidth="81.0" layoutX="14.0" layoutY="14.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../login/images/menu-Photoroom.png" />
               </image>
            </ImageView>

            <Button alignment="TOP_LEFT" layoutX="7.0" layoutY="93.0" mnemonicParsing="false" prefHeight="26.0" prefWidth="102.0" style="-fx-background-color: #6C5A86; -fx-background-radius: 18;" text="Dashboard " textFill="WHITE">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>

            <Button alignment="TOP_LEFT" layoutX="7.0" layoutY="137.0" mnemonicParsing="false" onAction="#handleCatalogueClick" prefHeight="26.0" prefWidth="102.0" style="-fx-background-color: #A89CB6; -fx-background-radius: 18;" text="Catalogue">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>

            <Button alignment="TOP_LEFT" layoutX="7.0" layoutY="178.0" mnemonicParsing="false" onAction="#handleMerchantsClick" prefHeight="26.0" prefWidth="102.0" style="-fx-background-color: #A89CB6; -fx-background-radius: 18;" text="Merchants">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>

            <Button alignment="TOP_LEFT" layoutX="7.0" layoutY="222.0" mnemonicParsing="false" onAction="#handleOrdersClick" prefHeight="26.0" prefWidth="102.0" style="-fx-background-color: #A89CB6; -fx-background-radius: 18;" text="Orders">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>

            <Button alignment="TOP_LEFT" layoutX="7.0" layoutY="263.0" mnemonicParsing="false" onAction="#handlePaymentsClick" prefHeight="26.0" prefWidth="102.0" style="-fx-background-color: #A89CB6; -fx-background-radius: 18;" text="Payments">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>

         <Button alignment="TOP_LEFT" layoutX="7.0" layoutY="303.0" mnemonicParsing="false" onAction="#handleReportsClick" prefHeight="26.0" prefWidth="102.0" style="-fx-background-color: #A89CB6; -fx-background-radius: 18;" text="Reports">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>

            <Button alignment="TOP_LEFT" layoutX="7.0" layoutY="347.0" mnemonicParsing="false" onAction="#handleStaffAccountsClick" prefHeight="26.0" prefWidth="121.0" style="-fx-background-color: #A89CB6; -fx-background-radius: 18;" text="Manage Accounts">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>

            <Button alignment="TOP_LEFT" layoutX="6.0" layoutY="395.0" mnemonicParsing="false" onAction="#handlePendingApplications" prefHeight="26.0" prefWidth="141.0" style="-fx-background-color: #A89CB6; -fx-background-radius: 18;" text="Pending Applications">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>
         </children>
      </AnchorPane>

      <AnchorPane fx:id="lowStockPane" managed="false" style="-fx-background-color: white; -fx-background-radius: 15;" visible="false" AnchorPane.bottomAnchor="55.0" AnchorPane.leftAnchor="190.0" AnchorPane.rightAnchor="387.0" AnchorPane.topAnchor="145.0">
         <children>
            <AnchorPane prefHeight="55.0" style="-fx-background-color: #e1c3c3; -fx-background-radius: 15 15 0 0;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
               <children>
                  <Label layoutX="20.0" layoutY="13.0" text="Low Stock Alert" textFill="#49454f">
                     <font>
                        <Font name="Verdana Bold" size="20.0" />
                     </font>
                  </Label>
               </children>
            </AnchorPane>

            <Label text="The following items are at or below their stock limit:" textFill="#49454f" wrapText="true" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="68.0">
               <font>
                  <Font size="13.0" />
               </font>
            </Label>

            <TableView fx:id="lowStockTable" AnchorPane.bottomAnchor="62.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="110.0">
               <columns>
                  <TableColumn fx:id="itemIdColumn" prefWidth="72.0" text="Item ID" />
                  <TableColumn fx:id="descriptionColumn" prefWidth="102.0" text="Description" />
                  <TableColumn fx:id="availabilityColumn" prefWidth="65.0" text="Available" />
                  <TableColumn fx:id="stockLimitColumn" prefWidth="62.0" text="Limit" />
               </columns>
            </TableView>

            <HBox alignment="CENTER" AnchorPane.bottomAnchor="18.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#handleDismissLowStockAlert" prefHeight="30.0" prefWidth="80.0" style="-fx-background-color: #6C5A86; -fx-background-radius: 18;" text="OK" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Button>
               </children>
            </HBox>
         </children>
      </AnchorPane>

      <AnchorPane fx:id="overdueAccountsPane" managed="false" style="-fx-background-color: white; -fx-background-radius: 15;" visible="false" AnchorPane.bottomAnchor="55.0" AnchorPane.leftAnchor="532.0" AnchorPane.rightAnchor="45.0" AnchorPane.topAnchor="145.0">
         <children>
            <AnchorPane prefHeight="55.0" style="-fx-background-color: #f1d3c2; -fx-background-radius: 15 15 0 0;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
               <children>
                  <Label layoutX="20.0" layoutY="13.0" text="Overdue Accounts Alert" textFill="#49454f">
                     <font>
                        <Font name="Verdana Bold" size="18.0" />
                     </font>
                  </Label>
               </children>
            </AnchorPane>

            <Label text="Accounts with overdue balances are highlighted and reminders are queued automatically." textFill="#49454f" wrapText="true" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="68.0">
               <font>
                  <Font size="13.0" />
               </font>
            </Label>

            <TableView fx:id="overdueAccountsTable" AnchorPane.bottomAnchor="18.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="120.0">
               <columns>
                  <TableColumn fx:id="overdueMerchantIdColumn" prefWidth="54.0" text="ID" />
                  <TableColumn fx:id="overdueCompanyColumn" prefWidth="84.0" text="Company" />
                  <TableColumn fx:id="overdueAccountNumberColumn" prefWidth="68.0" text="Account" />
                  <TableColumn fx:id="overdueDueDateColumn" prefWidth="56.0" text="Due Date" />
                  <TableColumn fx:id="overdueDaysColumn" prefWidth="44.0" text="Days" />
                  <TableColumn fx:id="overdueAmountColumn" prefWidth="58.0" text="Amount" />
                  <TableColumn fx:id="overdueStatusColumn" prefWidth="62.0" text="Status" />
               </columns>
            </TableView>
         </children>
      </AnchorPane>
      <Label layoutX="224.0" layoutY="85.0" prefHeight="24.0" prefWidth="141.0" text="Admin Account">
         <font>
            <Font name="Segoe UI Bold" size="19.0" />
         </font>
      </Label>

   </children>
</AnchorPane>
