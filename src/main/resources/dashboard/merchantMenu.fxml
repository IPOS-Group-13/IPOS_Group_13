<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #D2C3E3;"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.berrybyte.dashboard.MerchantMenuController">
   <children>

      <AnchorPane prefWidth="141.0"
                  style="-fx-background-color: #A89CB6; -fx-background-radius: 20;"
                  AnchorPane.topAnchor="37.0"
                  AnchorPane.bottomAnchor="37.0"
                  AnchorPane.leftAnchor="23.0">
         <children>
            <ImageView fitHeight="52.0"
                       fitWidth="81.0"
                       layoutX="14.0"
                       layoutY="14.0"
                       pickOnBounds="true"
                       preserveRatio="true">
               <image>
                  <Image url="@../login/images/menu-Photoroom.png" />
               </image>
            </ImageView>

            <Button alignment="TOP_LEFT"
                    layoutX="7.0"
                    layoutY="93.0"
                    mnemonicParsing="false"
                    onAction="#handleDashboardClick"
                    prefHeight="26.0"
                    prefWidth="102.0"
                    style="-fx-background-color: #A89CB6; -fx-background-radius: 18;"
                    text="Dashboard ">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>

            <Button alignment="TOP_LEFT"
                    layoutX="7.0"
                    layoutY="137.0"
                    mnemonicParsing="false"
                    onAction="#handleCatalogueClick"
                    prefHeight="26.0"
                    prefWidth="102.0"
                    style="-fx-background-color: #A89CB6; -fx-background-radius: 18;"
                    text="Catalogue">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>

            <Button alignment="TOP_LEFT"
                    layoutX="7.0"
                    layoutY="178.0"
                    mnemonicParsing="false"
                    prefHeight="26.0"
                    prefWidth="102.0"
                    style="-fx-background-color: #6C5A86; -fx-background-radius: 18;"
                    text="Merchants"
                    textFill="WHITE">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>

            <Button alignment="TOP_LEFT"
                    layoutX="7.0"
                    layoutY="222.0"
                    mnemonicParsing="false"
                    onAction="#handleOrdersClick"
                    prefHeight="26.0"
                    prefWidth="102.0"
                    style="-fx-background-color: #A89CB6; -fx-background-radius: 18;"
                    text="Orders">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>

            <Button alignment="TOP_LEFT"
                    layoutX="7.0"
                    layoutY="263.0"
                    mnemonicParsing="false"
                    onAction="#handlePaymentsClick"
                    prefHeight="26.0"
                    prefWidth="102.0"
                    style="-fx-background-color: #A89CB6; -fx-background-radius: 18;"
                    text="Payments">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>

            <Button alignment="TOP_LEFT"
                    layoutX="7.0"
                    layoutY="303.0"
                    mnemonicParsing="false"
                    prefHeight="26.0"
                    prefWidth="102.0"
                    style="-fx-background-color: #A89CB6; -fx-background-radius: 18;"
                    text="Reports">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>

            <Button alignment="TOP_LEFT"
                    layoutX="7.0"
                    layoutY="347.0"
                    mnemonicParsing="false"
                    onAction="#handleStaffAccountsClick"
                    prefHeight="26.0"
                    prefWidth="120.0"
                    style="-fx-background-color: #A89CB6; -fx-background-radius: 18;"
                    text="Manage Accounts">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>

            <Button alignment="TOP_LEFT"
                    layoutX="6.0"
                    layoutY="395.0"
                    mnemonicParsing="false"
                    prefHeight="26.0"
                    prefWidth="141.0"
                    style="-fx-background-color: #A89CB6; -fx-background-radius: 18;"
                    text="Pending Applications">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>
         </children>
      </AnchorPane>

      <Label text="Merchants"
             AnchorPane.topAnchor="36.0"
             AnchorPane.leftAnchor="200.0">
         <font>
            <Font name="Segoe UI Bold" size="36.0" />
         </font>
      </Label>

      <ImageView fx:id="profileImage"
                 fitHeight="52.0"
                 fitWidth="82.0"
                 onMouseClicked="#handleProfileClick"
                 pickOnBounds="true"
                 preserveRatio="true"
                 AnchorPane.topAnchor="36.0"
                 AnchorPane.rightAnchor="18.0">
         <image>
            <Image url="@../login/images/account_circle-Photoroom.png" />
         </image>
      </ImageView>

      <AnchorPane fx:id="profileMenuPane"
                  prefHeight="43.0"
                  prefWidth="200.0"
                  style="-fx-background-color: white; -fx-background-radius: 10;"
                  AnchorPane.topAnchor="79.0"
                  AnchorPane.rightAnchor="74.0">
         <children>
            <Button layoutX="14.0"
                    layoutY="9.0"
                    mnemonicParsing="false"
                    onAction="#handleLogoutMenuClick"
                    style="-fx-background-color: white;"
                    text="Logout">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>

            <ImageView fitHeight="33.0"
                       fitWidth="38.0"
                       layoutX="156.0"
                       layoutY="5.0"
                       pickOnBounds="true"
                       preserveRatio="true">
               <image>
                  <Image url="@../login/images/Log in-Photoroom.png" />
               </image>
            </ImageView>
         </children>
      </AnchorPane>

      <HBox alignment="CENTER"
            spacing="18.0"
            AnchorPane.topAnchor="94.0"
            AnchorPane.leftAnchor="186.0"
            AnchorPane.rightAnchor="20.0">
         <children>
            <TextField fx:id="searchField"
                       alignment="CENTER"
                       onAction="#handleSearch"
                       prefHeight="35.0"
                       prefWidth="282.0"
                       promptText="Search user"
                       style="-fx-background-radius: 18;" />

            <Button mnemonicParsing="false"
                    onAction="#handleSearch"
                    prefHeight="30.0"
                    prefWidth="110.0"
                    style="-fx-background-color: #6C5A86; -fx-background-radius: 18;"
                    text="Search"
                    textFill="WHITE">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>
         </children>
      </HBox>

      <Label fx:id="messageLabel"
             alignment="CENTER"
             contentDisplay="CENTER"
             prefHeight="18.0"
             textFill="#8f0808"
             AnchorPane.topAnchor="138.0"
             AnchorPane.leftAnchor="200.0"
             AnchorPane.rightAnchor="90.0" />

      <StackPane AnchorPane.topAnchor="150.0"
                 AnchorPane.bottomAnchor="24.0"
                 AnchorPane.leftAnchor="186.0"
                 AnchorPane.rightAnchor="20.0">
         <children>
            <AnchorPane prefHeight="420.0"
                        prefWidth="760.0"
                        minHeight="360.0"
                        minWidth="680.0"
                        maxHeight="500.0"
                        maxWidth="980.0"
                        style="-fx-background-color: #E8DEF8; -fx-background-radius: 20;">
               <children>
                  <TableView fx:id="merchantsTable"
                             AnchorPane.topAnchor="20.0"
                             AnchorPane.leftAnchor="20.0"
                             AnchorPane.rightAnchor="20.0"
                             AnchorPane.bottomAnchor="72.0">
                     <columns>
                        <TableColumn fx:id="nameColoumn" prefWidth="110.0" text="Name" />
                        <TableColumn fx:id="companyColoumn" prefWidth="115.0" text="Company" />
                        <TableColumn fx:id="iposIdColoumn" prefWidth="100.0" text="IPOS-ID" />
                        <TableColumn fx:id="creditLimitColoumn" prefWidth="121.60003662109375" text="Credit Limit" />
                        <TableColumn fx:id="discountPlanColoumn" prefWidth="96.0" text="Discount Plan" />
                        <TableColumn fx:id="outstandingColoumn" prefWidth="150.0" text="Outstanding Balance" />
                        <TableColumn fx:id="accountStatusColoumn" prefWidth="120.0" text="Account State" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>

                  <HBox alignment="CENTER"
                        spacing="10.0"
                        AnchorPane.leftAnchor="10.0"
                        AnchorPane.rightAnchor="10.0"
                        AnchorPane.bottomAnchor="20.0">
                     <children>
                        <Button fx:id="editMerchantDetailsButton"
                                mnemonicParsing="false"
                                onAction="#handleEditMerchantDetails"
                                prefHeight="34.0"
                                prefWidth="138.0"
                                style="-fx-background-color: #6C5A86; -fx-background-radius: 18;"
                                text="Edit Merchant Details"
                                textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Button>

                        <Button fx:id="updateDiscountPlanButton"
                                mnemonicParsing="false"
                                onAction="#handleUpdateDiscountPlan"
                                prefHeight="34.0"
                                prefWidth="138.0"
                                style="-fx-background-color: #6C5A86; -fx-background-radius: 18;"
                                text="Update Discount Plan"
                                textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Button>

                        <Button fx:id="deleteDiscountPlanButton"
                                mnemonicParsing="false"
                                onAction="#handleDeleteDiscountPlan"
                                prefHeight="34.0"
                                prefWidth="138.0"
                                style="-fx-background-color: #6C5A86; -fx-background-radius: 18;"
                                text="Delete Discount Plan"
                                textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Button>

                        <Button fx:id="restoreStateButton"
                                mnemonicParsing="false"
                                onAction="#handleRestoreState"
                                prefHeight="34.0"
                                prefWidth="138.0"
                                style="-fx-background-color: #6C5A86; -fx-background-radius: 18;"
                                text="Restore State"
                                textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Button>

                        <Button fx:id="deleteAccount"
                                mnemonicParsing="false"
                                onAction="#handleDeleteAccount"
                                prefHeight="34.0"
                                prefWidth="138.0"
                                style="-fx-background-color: #6C5A86; -fx-background-radius: 18;"
                                text="Delete Account"
                                textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Button>
                     </children>
                  </HBox>
               </children>
            </AnchorPane>
         </children>
      </StackPane>

   </children>
</AnchorPane>
