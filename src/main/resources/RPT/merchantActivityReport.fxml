<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0"
            style="-fx-background-color: linear-gradient(to bottom right, #D8CBE8, #D1C1E1);"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.berrybyte.RPT.controllers.MerchantActivityReportController">

    <children>

        <AnchorPane layoutX="30.0" layoutY="22.0" prefHeight="78.0" prefWidth="840.0"
                    style="-fx-background-color: transparent;">
            <children>
                <Label layoutX="12.0" layoutY="20.0"
                       text="Merchant Activity Report"
                       textFill="#2D2334">
                    <font>
                        <Font name="Segoe UI Bold" size="22.0" />
                    </font>
                </Label>

                <ImageView fitHeight="48.0" fitWidth="48.0"
                           layoutX="776.0" layoutY="9.0"
                           pickOnBounds="true"
                           preserveRatio="true">
                    <image>
                        <Image url="@../login/images/account_circle-Photoroom.png" />
                    </image>
                </ImageView>
            </children>
        </AnchorPane>

        <AnchorPane layoutX="30.0" layoutY="100.0" prefHeight="476.0" prefWidth="840.0"
                    style="-fx-background-color: rgba(255,255,255,0.10); -fx-background-radius: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 16, 0.14, 0, 4);">
            <children>

                <Label layoutX="20.0" layoutY="14.0"
                       text="Merchant Activity Detail"
                       textFill="#2D2334">
                    <font>
                        <Font name="Segoe UI Bold" size="20.0" />
                    </font>
                </Label>

                <Label fx:id="filterSummaryLabel"
                       layoutX="20.0" layoutY="42.0"
                       prefWidth="520.0"
                       text="Filters will appear here"
                       textFill="#6F6877">
                    <font>
                        <Font name="Segoe UI" size="12.0" />
                    </font>
                </Label>

                <Label fx:id="messageLabel"
                       layoutX="20.0" layoutY="60.0"
                       prefWidth="520.0"
                       textFill="#6F6877">
                    <font>
                        <Font name="Segoe UI" size="12.0" />
                    </font>
                </Label>

                <ScrollPane fitToWidth="true"
                            hbarPolicy="NEVER"
                            layoutX="20.0" layoutY="84.0"
                            prefHeight="310.0" prefWidth="800.0"
                            style="-fx-background-color: rgba(255,255,255,0.65); -fx-background-radius: 16; -fx-border-radius: 16;"
                            vbarPolicy="AS_NEEDED">
                    <content>
                        <VBox prefWidth="776.0" spacing="10.0" style="-fx-padding: 12;">
                            <children>
                                <Label fx:id="merchantHeaderLabel"
                                       text="Merchant details will appear here"
                                       textFill="#2D2334">
                                    <font>
                                        <Font name="Segoe UI Bold" size="14.0" />
                                    </font>
                                </Label>

                                <TextArea fx:id="activityTextArea"
                                          editable="false"
                                          prefHeight="240.0"
                                          prefWidth="752.0"
                                          wrapText="true"
                                          style="-fx-background-radius: 12; -fx-border-radius: 12; -fx-font-family: 'Segoe UI'; -fx-font-size: 12px;" />
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>

                <Button fx:id="exportPdfButton"
                        layoutX="20.0" layoutY="418.0"
                        mnemonicParsing="false"
                        onAction="#handleExportPdf"
                        prefHeight="34.0" prefWidth="166.0"
                        text="Export PDF"
                        style="-fx-background-color: #A99CB7; -fx-text-fill: #2D2334; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 14;" />

                <Button fx:id="sendEmailButton"
                        layoutX="193.0" layoutY="418.0"
                        mnemonicParsing="false"
                        onAction="#handleSendEmail"
                        prefHeight="34.0" prefWidth="166.0"
                        text="Send Email"
                        style="-fx-background-color: #A99CB7; -fx-text-fill: #2D2334; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 14;" />

                <Button fx:id="refreshButton"
                        layoutX="481.0" layoutY="418.0"
                        mnemonicParsing="false"
                        onAction="#handleRefresh"
                        prefHeight="34.0" prefWidth="166.0"
                        text="Refresh Report"
                        style="-fx-background-color: #A99CB7; -fx-text-fill: #2D2334; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 14;" />

                <Button fx:id="backButton"
                        layoutX="654.0" layoutY="418.0"
                        mnemonicParsing="false"
                        onAction="#handleBack"
                        prefHeight="34.0" prefWidth="166.0"
                        text="Back"
                        style="-fx-background-color: rgba(255,255,255,0.55); -fx-text-fill: #2D2334; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 14;" />

            </children>
        </AnchorPane>

    </children>
</AnchorPane>