<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #D2C3E3;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.berrybyte.RPT.controllers.MerchantActivityReportController">
    <children>

        <Label text="Merchant Activity Report" textFill="#2D2334" AnchorPane.leftAnchor="42.0" AnchorPane.topAnchor="42.0">
            <font>
                <Font name="Segoe UI Bold" size="24.0" />
            </font>
        </Label>

        <ImageView fx:id="profileImage" fitHeight="52.0" fitWidth="82.0"  pickOnBounds="true" preserveRatio="true" AnchorPane.rightAnchor="42.0" AnchorPane.topAnchor="36.0">
            <image>
                <Image url="@../login/images/account_circle-Photoroom.png" />
            </image>
        </ImageView>



        <AnchorPane style="-fx-background-color: #E8DEF8; -fx-background-radius: 15;" AnchorPane.bottomAnchor="25.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="105.0">
            <children>

                <Label text="Merchant Activity Detail" textFill="#49454F" AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="14.0">
                    <font>
                        <Font name="Segoe UI Bold" size="20.0" />
                    </font>
                </Label>

                <Label fx:id="filterSummaryLabel" text="Filters will appear here" textFill="#6F6877" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="42.0">
                    <font>
                        <Font name="Segoe UI" size="12.0" />
                    </font>
                </Label>

                <Label fx:id="messageLabel" textFill="#6F6877" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="60.0">
                    <font>
                        <Font name="Segoe UI" size="12.0" />
                    </font>
                </Label>

                <HBox alignment="CENTER_LEFT" spacing="16.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="82.0">
                    <children>
                        <ComboBox fx:id="merchantComboBox" editable="true" prefHeight="32.0" prefWidth="280.0" promptText="Select merchant" style="-fx-font-size: 12px; -fx-background-color: white; -fx-background-radius: 14;" />
                        <DatePicker fx:id="afterDatePicker" prefHeight="32.0" prefWidth="140.0" promptText="After" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: transparent;" />
                        <DatePicker fx:id="beforeDatePicker" prefHeight="32.0" prefWidth="140.0" promptText="Before" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: transparent;" />
                    </children>
                </HBox>

                <AnchorPane style="-fx-background-color: #F5F2F8; -fx-background-radius: 8;" AnchorPane.bottomAnchor="74.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="124.0">
                    <children>
                        <Label fx:id="merchantHeaderLabel" text="Merchant details will appear here" textFill="#2D2334" AnchorPane.leftAnchor="12.0" AnchorPane.rightAnchor="12.0" AnchorPane.topAnchor="12.0">
                            <font>
                                <Font name="Segoe UI Bold" size="14.0" />
                            </font>
                        </Label>

                        <TextArea fx:id="activityTextArea" editable="false" style="-fx-background-radius: 12; -fx-border-radius: 12; -fx-font-family: 'Segoe UI'; -fx-font-size: 12px;" wrapText="true" AnchorPane.bottomAnchor="12.0" AnchorPane.leftAnchor="12.0" AnchorPane.rightAnchor="12.0" AnchorPane.topAnchor="42.0" />
                    </children>
                </AnchorPane>

                <HBox alignment="CENTER" spacing="24.0" AnchorPane.bottomAnchor="24.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0">
                    <children>
                        <Button fx:id="exportPdfButton" mnemonicParsing="false" onAction="#handleExportPdf" prefHeight="34.0" prefWidth="166.0" style="-fx-background-color: #6C5A86; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 14;" text="Export PDF" />
                        <Button fx:id="sendEmailButton" mnemonicParsing="false" onAction="#handleSendEmail" prefHeight="34.0" prefWidth="166.0" style="-fx-background-color: #6C5A86; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 14;" text="Send Email" />
                        <Button fx:id="refreshButton" mnemonicParsing="false" onAction="#handleRefresh" prefHeight="34.0" prefWidth="166.0" style="-fx-background-color: #6C5A86; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 14;" text="Refresh Report" />
                        <Button fx:id="backButton" mnemonicParsing="false" onAction="#handleBack" prefHeight="34.0" prefWidth="166.0" style="-fx-background-color: #6C5A86; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 14;" text="Back" />
                    </children>
                </HBox>

            </children>
        </AnchorPane>

    </children>
</AnchorPane>
