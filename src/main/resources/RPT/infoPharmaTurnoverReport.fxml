<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #D2C3E3;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.berrybyte.RPT.controllers.InfoPharmaTurnoverReportController">
    <children>

        <Label text="InfoPharma Turnover Report" textFill="#2D2334" AnchorPane.leftAnchor="42.0" AnchorPane.topAnchor="42.0">
            <font>
                <Font name="Segoe UI Bold" size="24.0" />
            </font>
        </Label>

        <ImageView fx:id="profileImage" fitHeight="52.0" fitWidth="82.0" onMouseClicked="#handleProfileClick" pickOnBounds="true" preserveRatio="true" AnchorPane.rightAnchor="42.0" AnchorPane.topAnchor="36.0">
            <image>
                <Image url="@../login/images/account_circle-Photoroom.png" />
            </image>
        </ImageView>

        <AnchorPane fx:id="profileMenuPane" prefHeight="43.0" prefWidth="200.0" style="-fx-background-color: white; -fx-background-radius: 10;" AnchorPane.rightAnchor="98.0" AnchorPane.topAnchor="79.0">
            <children>
                <Button layoutX="14.0" layoutY="9.0" mnemonicParsing="false" onAction="#handleLogoutMenuClick" style="-fx-background-color: white;" text="Logout">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>
                <ImageView fitHeight="33.0" fitWidth="38.0" layoutX="156.0" layoutY="5.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../login/images/Log in-Photoroom.png" />
                    </image>
                </ImageView>
            </children>
        </AnchorPane>

        <AnchorPane style="-fx-background-color: #E8DEF8; -fx-background-radius: 15;" AnchorPane.bottomAnchor="25.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="105.0">
            <children>

                <Label text="Internal Turnover Summary" textFill="#49454F" AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="14.0">
                    <font>
                        <Font name="Segoe UI Bold" size="20.0" />
                    </font>
                </Label>

                <Label fx:id="filterSummaryLabel" text="Date range filter will appear here" textFill="#6F6877" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="42.0">
                    <font>
                        <Font name="Segoe UI" size="12.0" />
                    </font>
                </Label>

                <Label fx:id="messageLabel" textFill="#6F6877" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="60.0">
                    <font>
                        <Font name="Segoe UI" size="12.0" />
                    </font>
                </Label>

                <TextArea fx:id="turnoverSummaryTextArea" editable="false" style="-fx-background-radius: 16; -fx-border-radius: 16; -fx-font-family: 'Segoe UI'; -fx-font-size: 12px;" wrapText="true" AnchorPane.bottomAnchor="74.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="84.0" />

                <HBox alignment="CENTER" spacing="40.0" AnchorPane.bottomAnchor="24.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0">
                    <children>
                        <Button fx:id="refreshButton" mnemonicParsing="false" onAction="#handleRefresh" prefHeight="34.0" prefWidth="166.0" style="-fx-background-color: #6C5A86; -fx-background-radius: 14;" text="Refresh Report" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font></Button>
                        <Button fx:id="exportPdfButton" mnemonicParsing="false" onAction="#handleExportPdf" prefHeight="34.0" prefWidth="166.0" style="-fx-background-color: #6C5A86; -fx-background-radius: 14;" text="Export PDF" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font></Button>
                        <Button fx:id="backButton" mnemonicParsing="false" onAction="#handleBack" prefHeight="34.0" prefWidth="166.0" style="-fx-background-color: #6C5A86; -fx-background-radius: 14;" text="Back" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font></Button>
                    </children>
                </HBox>

            </children>
        </AnchorPane>

    </children>
</AnchorPane>
