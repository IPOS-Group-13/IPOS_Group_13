                                    </font>
                                 </Label>
                                 <Label text="Generate a list of invoices raised by InfoPharma within the selected period." textFill="#6F6877" wrapText="true">
                                    <font>
                                       <Font name="Segoe UI" size="12.0" />
                                    </font>
                                 </Label>
                              </children>
                           </VBox>
