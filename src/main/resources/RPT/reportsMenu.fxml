                     <!-- Report 1 -->
                     <AnchorPane onMouseClicked="#openStockTurnoverReport" prefHeight="108.0" prefWidth="286.0" style="-fx-background-color: rgba(255,255,255,0.45); -fx-background-radius: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 12, 0.14, 0, 3);">
