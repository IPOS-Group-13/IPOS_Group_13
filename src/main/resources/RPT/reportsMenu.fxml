                  <Button alignment="CENTER_LEFT" mnemonicParsing="false" onAction="#handleStaffAccountsClick" prefHeight="36.0" prefWidth="140.0" style="-fx-background-color: transparent; -fx-text-fill: #2F2437; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 16;" text="Manage Accounts" />
                  <Button alignment="CENTER_LEFT" mnemonicParsing="false" onAction="#handlePendingClick" prefHeight="36.0" prefWidth="150.0" style="-fx-background-color: transparent; -fx-text-fill: #2F2437; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 16;" text="Pending Applications" />
               </children>
            </VBox>
         </children>
      </AnchorPane>

