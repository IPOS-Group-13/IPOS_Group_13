                     <AnchorPane onMouseClicked="#openInvoicesRaisedAgainstMerchant" prefHeight="108.0" prefWidth="286.0" style="-fx-background-color: rgba(255,255,255,0.45); -fx-background-radius: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 12, 0.14, 0, 3);">
                        <children>
                           <ImageView fitHeight="24.0" fitWidth="24.0" layoutX="14.0" layoutY="16.0" pickOnBounds="true" preserveRatio="true">
                              <image>
                                 <Image url="@../login/images/Info-removebg-preview.png" />
                              </image>
                           </ImageView>
                           <VBox layoutX="46.0" layoutY="14.0" prefWidth="224.0" spacing="6.0">
                              <children>
                                 <Label text="InvoicesRaisedAgainstMerchant" textFill="#2D2334">
                                    <font>
                                       <Font name="Segoe UI Bold" size="14.0" />
                                    </font>
                                 </Label>
                                 <Label text="Generate a list of invoices raised against a specific merchant." textFill="#6F6877" wrapText="true">
                                    <font>
                                       <Font name="Segoe UI" size="12.0" />
                                    </font>
                                 </Label>
                              </children>
                           </VBox>
                        </children>
                     </AnchorPane>

                     <!-- Report 7 -->
                     <AnchorPane onMouseClicked="#openInvoicesRaisedByInfoPharma" prefHeight="108.0" prefWidth="286.0" style="-fx-background-color: rgba(255,255,255,0.45); -fx-background-radius: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 12, 0.14, 0, 3);">
                        <children>
                           <ImageView fitHeight="24.0" fitWidth="24.0" layoutX="14.0" layoutY="16.0" pickOnBounds="true" preserveRatio="true">
                              <image>
