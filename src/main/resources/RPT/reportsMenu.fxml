                                 </Label>
                              </children>
                           </VBox>
                        </children>
                     </AnchorPane>

                     <!-- Report 5 -->
                     <AnchorPane onMouseClicked="#openMerchantOrderReport" prefHeight="108.0" prefWidth="286.0" style="-fx-background-color: rgba(255,255,255,0.45); -fx-background-radius: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 12, 0.14, 0, 3);">
                        <children>
                           <ImageView fitHeight="24.0" fitWidth="24.0" layoutX="14.0" layoutY="16.0" pickOnBounds="true" preserveRatio="true">
                              <image>
                                 <Image url="@../login/images/Info-removebg-preview.png" />
                              </image>
                           </ImageView>
                           <VBox layoutX="46.0" layoutY="14.0" prefWidth="224.0" spacing="6.0">
                              <children>
