               <children>
                  <TextField fx:id="merchantSearchField" layoutX="12.0" layoutY="5.0" prefHeight="30.0" prefWidth="248.0" promptText="Merchant name" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-prompt-text-fill: #9C96A3; -fx-text-fill: #2F2437; -fx-font-size: 12px;" />

                  <ImageView fitHeight="22.0" fitWidth="22.0" layoutX="267.0" layoutY="9.0" pickOnBounds="true" preserveRatio="true">
