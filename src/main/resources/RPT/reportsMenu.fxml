         <children>

            <ImageView fitHeight="56.0" fitWidth="76.0" layoutX="18.0" layoutY="18.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../login/images/menu-Photoroom.png" />
               </image>
            </ImageView>

            <VBox layoutX="5.0" layoutY="92.0" prefHeight="324.0" prefWidth="150.0" spacing="12.0">
               <children>
                  <Button alignment="CENTER_LEFT" mnemonicParsing="false" onAction="#handleDashboardClick" prefHeight="36.0" prefWidth="140.0" style="-fx-background-color: transparent; -fx-text-fill: #2F2437; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 16;" text="Dashboard" />
                  <Button alignment="CENTER_LEFT" mnemonicParsing="false" onAction="#handleCatalougeClick" prefHeight="36.0" prefWidth="140.0" style="-fx-background-color: transparent; -fx-text-fill: #2F2437; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 16;" text="Catalogue" />
                  <Button alignment="CENTER_LEFT" mnemonicParsing="false" onAction="#handleMerchantsClick" prefHeight="36.0" prefWidth="140.0" style="-fx-background-color: transparent; -fx-text-fill: #2F2437; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 16;" text="Merchants" />
                  <Button alignment="CENTER_LEFT" mnemonicParsing="false" onAction="#handleOrderClick" prefHeight="36.0" prefWidth="140.0" style="-fx-background-color: transparent; -fx-text-fill: #2F2437; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 16;" text="Orders" />
