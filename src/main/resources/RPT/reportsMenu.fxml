                              </image>
                           </ImageView>
                           <VBox layoutX="46.0" layoutY="14.0" prefWidth="224.0" spacing="6.0">
                              <children>
                                 <Label text="InvoicesRaisedByInfoPharma" textFill="#2D2334">
                                    <font>
