                           <ImageView fitHeight="24.0" fitWidth="24.0" layoutX="14.0" layoutY="16.0" pickOnBounds="true" preserveRatio="true">
                              <image>
                                 <Image url="@../login/images/Info-removebg-preview.png" />
                              </image>
                           </ImageView>
                           <VBox layoutX="46.0" layoutY="14.0" prefWidth="224.0" spacing="6.0">
                              <children>
                                 <Label text="StockTurnOverReport" textFill="#2D2334">
                                    <font>
                                       <Font name="Segoe UI Bold" size="14.0" />
                                    </font>
                                 </Label>
                                 <Label text="Generate an outbound turnover report for a given date range." textFill="#6F6877" wrapText="true">
                                    <font>
                                       <Font name="Segoe UI" size="12.0" />
                                    </font>
                                 </Label>
                              </children>
                           </VBox>
                        </children>
                     </AnchorPane>

                     <!-- Report 2 -->
                     <AnchorPane onMouseClicked="#openMerchantActivityReport" prefHeight="108.0" prefWidth="286.0" style="-fx-background-color: rgba(255,255,255,0.65); -fx-background-radius: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.14), 14, 0.16, 0, 4);">
