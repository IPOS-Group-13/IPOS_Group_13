            </Label>

            <DatePicker fx:id="beforeDatePicker" layoutX="324.0" layoutY="28.0" prefHeight="32.0" prefWidth="104.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: transparent;" />

