                           <ImageView fitHeight="24.0" fitWidth="24.0" layoutX="14.0" layoutY="16.0" pickOnBounds="true" preserveRatio="true">
                              <image>
                                 <Image url="@../login/images/Info-removebg-preview.png" />
                              </image>
                           </ImageView>
                           <VBox layoutX="46.0" layoutY="14.0" prefWidth="224.0" spacing="6.0">
                              <children>
                                 <Label text="MerchantActivityReport" textFill="#2D2334">
                                    <font>
                                       <Font name="Segoe UI Bold" size="14.0" />
                                    </font>
                                 </Label>
                                 <Label text="Generate an activity report for a given merchant account." textFill="#6F6877" wrapText="true">
                                    <font>
                                       <Font name="Segoe UI" size="12.0" />
