                                    </font>
                                 </Label>
                                 <Label text="Generate a list of stock below the threshold that requires resupply." textFill="#6F6877" wrapText="true">
                                    <font>
                                       <Font name="Segoe UI" size="12.0" />
                                    </font>
                                 </Label>
                              </children>
                           </VBox>
                        </children>
