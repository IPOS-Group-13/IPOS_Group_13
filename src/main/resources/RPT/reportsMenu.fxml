            <DatePicker fx:id="afterDatePicker" layoutX="446.0" layoutY="28.0" prefHeight="32.0" prefWidth="104.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: transparent;" />

            <AnchorPane fx:id="profileIconArea" layoutX="594.0" layoutY="0.0" onMouseClicked="#handleProfileClick" prefHeight="46.0" prefWidth="46.0" style="-fx-background-color: transparent;">
