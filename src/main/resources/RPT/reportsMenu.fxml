                  <Circle centerX="23.0" centerY="23.0" radius="18.0" style="-fx-fill: transparent; -fx-stroke: #2D2334; -fx-stroke-width: 2;" />
                  <ImageView fitHeight="48.0" fitWidth="48.0" layoutY="-1.0" pickOnBounds="true">
