<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: linear-gradient(to bottom right, #D8CBE8, #D1C1E1);" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.berrybyte.RPT.controllers.OverdueBalanceReportController">

    <children>

        <Label text="Overdue Balance Report" textFill="#2D2334" AnchorPane.leftAnchor="42.0" AnchorPane.topAnchor="42.0">
            <font>
                <Font name="Segoe UI Bold" size="24.0" />
            </font>
        </Label>

        <ImageView fx:id="profileImage" fitHeight="52.0" fitWidth="82.0" onMouseClicked="#handleProfileClick" pickOnBounds="true" preserveRatio="true" AnchorPane.rightAnchor="18.0" AnchorPane.topAnchor="36.0">
            <image>
                <Image url="@../login/images/account_circle-Photoroom.png" />
            </image>
        </ImageView>

        <AnchorPane fx:id="profileMenuPane" prefHeight="43.0" prefWidth="200.0" style="-fx-background-color: white; -fx-background-radius: 10;" AnchorPane.rightAnchor="74.0" AnchorPane.topAnchor="79.0">
            <children>
                <Button layoutX="14.0" layoutY="9.0" mnemonicParsing="false" onAction="#handleLogoutMenuClick" style="-fx-background-color: white;" text="Logout">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>
                <ImageView fitHeight="33.0" fitWidth="38.0" layoutX="156.0" layoutY="5.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../login/images/Log in-Photoroom.png" />
                    </image>
                </ImageView>
            </children>
        </AnchorPane>

        <AnchorPane style="-fx-background-color: #E8DEF8; -fx-background-radius: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 16, 0.14, 0, 4);" AnchorPane.bottomAnchor="24.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="105.0">
            <children>

                <Label text="Overdue Account Summary" textFill="#2D2334">
                    <font>
                        <Font name="Segoe UI Bold" size="20.0" />
                    </font>
                    <AnchorPane.leftAnchor>20.0</AnchorPane.leftAnchor>
                    <AnchorPane.topAnchor>14.0</AnchorPane.topAnchor>
                </Label>

                <Label fx:id="filterSummaryLabel" text="Scope will appear here" textFill="#6F6877">
                    <font>
                        <Font name="Segoe UI" size="12.0" />
                    </font>
                    <AnchorPane.leftAnchor>20.0</AnchorPane.leftAnchor>
                    <AnchorPane.rightAnchor>20.0</AnchorPane.rightAnchor>
                    <AnchorPane.topAnchor>42.0</AnchorPane.topAnchor>
                </Label>

                <Label fx:id="messageLabel" textFill="#6F6877">
                    <font>
                        <Font name="Segoe UI" size="12.0" />
                    </font>
                    <AnchorPane.leftAnchor>20.0</AnchorPane.leftAnchor>
                    <AnchorPane.rightAnchor>20.0</AnchorPane.rightAnchor>
                    <AnchorPane.topAnchor>60.0</AnchorPane.topAnchor>
                </Label>

                <TableView fx:id="overdueTable" style="-fx-background-radius: 16; -fx-border-radius: 16;" AnchorPane.bottomAnchor="92.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="100.0">
                    <columns>
                        <TableColumn fx:id="merchantIdColumn" prefWidth="85.0" text="Merchant ID" />
                        <TableColumn fx:id="companyNameColumn" prefWidth="210.0" text="Company" />
                        <TableColumn fx:id="accountNumberColumn" prefWidth="140.0" text="IPOS Account" />
                        <TableColumn fx:id="accountStatusColumn" prefWidth="95.0" text="Status" />
                        <TableColumn fx:id="oldestDueDateColumn" prefWidth="95.0" text="Oldest Due" />
                        <TableColumn fx:id="overdueAmountColumn" prefWidth="110.0" text="Overdue Amount" />
                        <TableColumn fx:id="overdueInvoiceCountColumn" prefWidth="65.0" text="Invoices" />
                    </columns>
                </TableView>

                <HBox alignment="CENTER" spacing="24.0" AnchorPane.bottomAnchor="24.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0">
                    <children>
                        <Button fx:id="refreshButton" mnemonicParsing="false" onAction="#handleRefresh" prefHeight="34.0" prefWidth="166.0" style="-fx-background-color: #6C5A86; -fx-background-radius: 14;" text="Refresh Report" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font></Button>

                        <Button fx:id="exportPdfButton" mnemonicParsing="false" onAction="#handleExportPdf" prefHeight="34.0" prefWidth="166.0" style="-fx-background-color: #6C5A86; -fx-background-radius: 14;" text="Export PDF" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font></Button>

                        <Button fx:id="backButton" mnemonicParsing="false" onAction="#handleBack" prefHeight="34.0" prefWidth="166.0" style="-fx-background-color: #6C5A86; -fx-background-radius: 14;" text="Back" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font></Button>
                    </children>
                </HBox>

            </children>
        </AnchorPane>

    </children>
</AnchorPane>
